{
  "pipeline_name": "Workplace_Safety_Sentinel",
  "version": "0.5.1",
  "target_framework": "DeepStream 7.0 / TensorRT 10.x",
  "hardware_target": "NVIDIA Jetson / x86_64 Ampere/Ada GPU",
  "nodes": [
    {
      "id": "source_0",
      "type": "v4l2src",
      "properties": {
        "device": "/dev/video0",
        "caps": "video/x-raw, width=1920, height=1080, framerate=30/1"
      }
    },
    {
      "id": "videoconvert_0",
      "type": "nvvideoconvert",
      "properties": {
        "nvbuf-memory-type": 0
      }
    },
    {
      "id": "streammux_0",
      "type": "nvstreammux",
      "properties": {
        "batch-size": 1,
        "width": 640,
        "height": 640,
        "batched-push-timeout": 33333
      }
    },
    {
      "id": "pgie_0",
      "type": "nvinfer",
      "properties": {
        "config-file-path": "config_infer_primary_yolo.txt",
        "model-engine-file": "model/yolov8s_fp16.engine",
        "network-mode": 1,
        "process-mode": 1
      }
    },
    {
      "id": "tracker_0",
      "type": "nvtracker",
      "properties": {
        "ll-lib-file": "/opt/nvidia/deepstream/deepstream/lib/libnvds_nvmultiobjecttracker.so",
        "ll-config-file": "config_tracker_NvDCF_perf.yml",
        "tracker-width": 640,
        "tracker-height": 384
      }
    },
    {
      "id": "analytics_0",
      "type": "nvdsanalytics",
      "properties": {
        "config-file": "config_nvdsanalytics_hazard_zone.txt",
        "enable-roi-zone-breach": true,
        "enable-line-crossing": true
      }
    },
    {
      "id": "osd_0",
      "type": "nvdsosd",
      "properties": {
        "process-mode": 2,
        "display-text": 1,
        "display-bbox": 1
      }
    },
    {
      "id": "msgbroker_0",
      "type": "nvmsgbroker",
      "properties": {
        "proto-lib": "/opt/nvidia/deepstream/deepstream/lib/libnvds_mqtt_proto.so",
        "conn-str": "localhost;1883;site/safety/alerts",
        "topic": "site/safety/alerts"
      }
    },
    {
      "id": "sink_0",
      "type": "nv3dsink",
      "properties": {
        "sync": 0,
        "async": false
      }
    }
  ],
  "edges": [
    {"from": "source_0", "to": "videoconvert_0"},
    {"from": "videoconvert_0", "to": "streammux_0"},
    {"from": "streammux_0", "to": "pgie_0"},
    {"from": "pgie_0", "to": "tracker_0"},
    {"from": "tracker_0", "to": "analytics_0"},
    {"from": "analytics_0", "to": "osd_0"},
    {"from": "osd_0", "to": "sink_0"},
    {"from": "analytics_0", "to": "msgbroker_0"}
  ]
}
